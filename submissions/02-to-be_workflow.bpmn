    <bpmn:textAnnotation id="TextAnnotation_1k43ago">
      <bpmn:text>Reduced admin effort</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1apdalt">
      <bpmn:text>Faster next action: Customer can use portal instead of waiting to be contacted by a rep</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_02hxwit">
      <bpmn:text>Reduced admin effort</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04cc2zm">
      <bpmn:text>Clearer reporting: ensures account context is preserved centrally. Reduced admin effort: reps don't need to manually update across sources</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ot5zsw">
      <bpmn:text>Faster next action: no need for reps to search for account data manually</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_055q24t">
      <bpmn:text>Clearer reporting: ensures account context is preserved centrally. Reduced admin effort: reps don't need to manually update across sources</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04bk1ds">
      <bpmn:text>Reduced admin effort: reps don't need to negotiate and discuss repayment with each customers</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ctsusl">
      <bpmn:text>Reduced admin effort and improved follow-up consistency: reps need not remember to manually check</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1l54jhe">
      <bpmn:text>Reduced admin effort and improved follow-up consistency: reps need not remember to manually check</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1qqi6qi">
      <bpmn:text>Clearer reporting: ensures account context is preserved centrally. Reduced admin effort: reps don't need to manually update across sources</bpmn:text>
    </bpmn:textAnnotation>
